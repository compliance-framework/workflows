ow-fs-write`.\r\n\r\nThis can lead to confidentiality impact or bypass of the intended security boundary under affected configurations.\r\n\r\nThis vulnerability affects Node.js **22.x**, **24.x**, and **26.x**.","aliases":["BIT-node-min-2026-56847","CVE-2026-56847"],"modified":"2026-09-08T08:48:10.752361961Z","published":"2026-08-17T05:52:23.515Z","database_specific":{"severity":"Medium","cpes":["cpe:2.3:a:nodejs:node.js:*:*:*:*:*:*:*:*"]},"references":[{"type":"ADVISORY","url":"https://nodejs.org/en/blog/vulnerability/july-2026-security-releases"},{"type":"WEB","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-56847"}],"affected":[{"package":{"name":"node","ecosystem":"Bitnami","purl":"pkg:bitnami/node"},"ranges":[{"type":"SEMVER","events":[{"introduced":"0"},{"fixed":"22.23.2"},{"introduced":"23.0.0"},{"fixed":"24.18.1"},{"introduced":"25.0.0"},{"fixed":"26.5.1"}]}],"database_specific":{"source":"https://github.com/bitnami/vulndb/tree/main/data/node/BIT-node-2026-56847.json"},"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:L/AC:L/PR:L/UI:N/S:U/C:H/I:L/A:N"}]}],"schema_version":"1.9.0"},{"id":"BIT-node-2026-56848","details":"A flaw in Node.js HTTP/2 handling allows `nghttp2_session_mem_send()` to be called re-entrantly while `nghttp2_session_mem_recv()` is executing, resulting in a heap-use-after-free.\r\n\r\nThis vulnerability affects Node.js **26.x**, **24.x**, and **22.x**.","aliases":["BIT-node-min-2026-56848","CVE-2026-56848"],"modified":"2026-08-17T08:11:08.159353149Z","published":"2026-08-17T05:52:24.953Z","database_specific":{"severity":"High","cpes":["cpe:2.3:a:nodejs:node.js:*:*:*:*:*:*:*:*"]},"references":[{"type":"WEB","url":"https://nodejs.org/en/blog/vulnerability/july-2026-security-releases"},{"type":"WEB","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-56848"}],"affected":[{"package":{"name":"node","ecosystem":"Bitnami","purl":"pkg:bitnami/node"},"ranges":[{"type":"SEMVER","events":[{"introduced":"0"},{"fixed":"22.23.2"},{"introduced":"23.0.0"},